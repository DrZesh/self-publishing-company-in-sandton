{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/isbn",
      "destination": "/how-to-get-an-isbn-in-south-africa",
      "permanent": true
    },
    {
      "source": "/isbnregistration",
      "destination": "/how-to-get-an-isbn-in-south-africa",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/portal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
