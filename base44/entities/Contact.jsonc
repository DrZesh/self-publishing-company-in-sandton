{
  "name": "Contact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Contact's full name"
    },
    "email": {
      "type": "string",
      "description": "Primary email address"
    },
    "email_secondary": {
      "type": "string",
      "description": "Secondary email address"
    },
    "phone": {
      "type": "string",
      "description": "Primary phone number"
    },
    "phone_secondary": {
      "type": "string",
      "description": "Secondary phone number"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp contact number"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "role": {
      "type": "string",
      "enum": [
        "author",
        "publisher",
        "agent",
        "other"
      ],
      "description": "Contact role"
    },
    "street_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "South Africa"
    },
    "author_bio": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "social_links": {
      "type": "object"
    },
    "how_heard": {
      "type": "string",
      "enum": [
        "google",
        "referral",
        "social",
        "event",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "subscriber",
        "lead",
        "customer",
        "repeat_customer",
        "past_customer"
      ],
      "default": "lead"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "first_contact_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date-time"
    },
    "custom_fields": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "book_title": {
      "type": "string",
      "description": "Book title in progress"
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "New Enquiry",
        "Information Requested",
        "Quote in Progress",
        "Quote Sent",
        "Payment Pending",
        "Project Started",
        "Editing",
        "Cover Design",
        "Typesetting",
        "Sample Queued",
        "Sample Approved",
        "Mass Production",
        "Completed",
        "Delivered",
        "Lost"
      ],
      "default": "New Enquiry"
    },
    "pipeline_stage_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline_value": {
      "type": "number"
    },
    "pipeline_owner": {
      "type": "string"
    },
    "lost_reason": {
      "type": "string"
    },
    "do_not_contact": {
      "type": "boolean",
      "default": false,
      "description": "If true, skip all automated and manual outreach \u2014 legal / admin flag"
    },
    "unsubscribed": {
      "type": "boolean",
      "default": false,
      "description": "Client opted out via unsubscribe link \u2014 required for POPIA compliance"
    },
    "unsubscribed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client unsubscribed"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}