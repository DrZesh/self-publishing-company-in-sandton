{
  "name": "Contract",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Linked Contact ID"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project ID"
    },
    "title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Contract",
        "NDA",
        "Publishing Agreement",
        "Book Cover Agreement",
        "Editing Agreement",
        "Printing Agreement",
        "Supplier Agreement",
        "Freelancer Agreement",
        "Payment Agreement",
        "Approval Form",
        "Author Agreement",
        "Internal Document",
        "Legal Document",
        "Other"
      ],
      "default": "Contract",
      "description": "Type of document"
    },
    "book_title": {
      "type": "string",
      "description": "Client or company name / book title"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Admin Fields Completed",
        "Admin Signed",
        "Sent for Signature",
        "Opened",
        "Viewed",
        "Signing Started",
        "Signed",
        "Fully Signed",
        "Declined",
        "Expired",
        "Resent",
        "Cancelled",
        "Archived"
      ],
      "default": "Draft"
    },
    "contract_file_url": {
      "type": "string",
      "description": "Unsigned document file URL"
    },
    "signed_file_url": {
      "type": "string",
      "description": "Signed document file URL"
    },
    "sign_token": {
      "type": "string"
    },
    "sign_token_expires": {
      "type": "string",
      "format": "date-time"
    },
    "admin_signature_url": {
      "type": "string",
      "description": "Admin signature image URL"
    },
    "admin_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_signer_name": {
      "type": "string"
    },
    "admin_signer_email": {
      "type": "string"
    },
    "contract_field_values": {
      "type": "object",
      "description": "Admin pre-filled field values"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "signer_ip": {
      "type": "string"
    },
    "signer_user_agent": {
      "type": "string"
    },
    "signature_image_url": {
      "type": "string"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_reason": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "reminder_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_count": {
      "type": "number",
      "default": 0
    },
    "legal_consent_checked": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "contact_id",
    "title"
  ]
}