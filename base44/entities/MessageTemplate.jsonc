{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name e.g. Project Welcome"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp"
      ],
      "default": "email"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line (supports {{variables}})"
    },
    "content_html": {
      "type": "string",
      "description": "Inner content HTML only \u2014 branded shell applied at render time. Supports {{variables}}."
    },
    "variables_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of variable names used in this template e.g. client_name, project_name"
    },
    "category": {
      "type": "string",
      "enum": [
        "welcome",
        "stage_update",
        "payment",
        "files",
        "proof",
        "approval",
        "printing",
        "collection",
        "delivery",
        "completion",
        "reminder",
        "review",
        "delay",
        "general"
      ],
      "default": "general"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Protects seed templates from deletion \u2014 can be restored to original"
    },
    "default_content_html": {
      "type": "string",
      "description": "Original seed content for restore functionality"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "channel",
    "content_html"
  ]
}