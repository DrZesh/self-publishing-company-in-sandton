{
  "name": "ESignatureRequest",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Linked Document ID"
    },
    "contact_id": {
      "type": "string",
      "description": "Linked Contact ID"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project ID"
    },
    "title": {
      "type": "string",
      "description": "Document title shown to signer"
    },
    "file_url": {
      "type": "string",
      "description": "URL of document to sign"
    },
    "file_name": {
      "type": "string"
    },
    "document_category": {
      "type": "string"
    },
    "signing_order": {
      "type": "string",
      "enum": [
        "admin_first",
        "client_first",
        "any_order"
      ],
      "default": "admin_first",
      "description": "Who signs first"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Prepared",
        "Admin Fields Completed",
        "Admin Signed",
        "Sent",
        "Delivered",
        "Opened",
        "Viewed",
        "Signing Started",
        "Client Signed",
        "Fully Signed",
        "Declined",
        "Expired",
        "Cancelled",
        "Archived"
      ],
      "default": "Draft"
    },
    "contract_fields": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Field definitions: {id, label, type, assigned_to, required, value}"
    },
    "admin_field_values": {
      "type": "object",
      "description": "Admin-filled field values keyed by field id"
    },
    "client_field_values": {
      "type": "object",
      "description": "Client-filled field values keyed by field id"
    },
    "admin_signature_url": {
      "type": "string",
      "description": "Admin signature image URL"
    },
    "admin_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_signer_name": {
      "type": "string"
    },
    "admin_signer_email": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_phone": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "sign_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "allow_download_before_sign": {
      "type": "boolean",
      "default": true
    },
    "allow_download_after_sign": {
      "type": "boolean",
      "default": true
    },
    "send_whatsapp": {
      "type": "boolean",
      "default": false
    },
    "email_subject": {
      "type": "string"
    },
    "email_message": {
      "type": "string"
    },
    "reminder_days": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "reminder_sent_count": {
      "type": "number",
      "default": 0
    },
    "last_reminder_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signing_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Client signed at"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "decline_reason": {
      "type": "string"
    },
    "signature_image_url": {
      "type": "string",
      "description": "Client signature image URL"
    },
    "signature_method": {
      "type": "string",
      "enum": [
        "drawn",
        "typed"
      ]
    },
    "signer_confirmed_name": {
      "type": "string"
    },
    "signer_confirmed_email": {
      "type": "string"
    },
    "signer_ip": {
      "type": "string"
    },
    "signer_device": {
      "type": "string"
    },
    "signer_browser": {
      "type": "string"
    },
    "signer_user_agent": {
      "type": "string"
    },
    "consent_read": {
      "type": "boolean",
      "default": false
    },
    "consent_identity": {
      "type": "boolean",
      "default": false
    },
    "consent_authorised": {
      "type": "boolean",
      "default": false
    },
    "consent_electronic": {
      "type": "boolean",
      "default": false
    },
    "consent_submit": {
      "type": "boolean",
      "default": false
    },
    "signed_document_url": {
      "type": "string"
    },
    "pdf_generation_status": {
      "type": "string"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sent_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "open_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "recipient_email",
    "file_url"
  ]
}