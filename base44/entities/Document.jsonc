{
  "name": "Document",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Linked Contact ID"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project ID"
    },
    "quote_id": {
      "type": "string",
      "description": "Linked Quote ID"
    },
    "invoice_id": {
      "type": "string",
      "description": "Linked Invoice ID"
    },
    "category": {
      "type": "string",
      "enum": [
        "Signed Contract",
        "Unsigned Contract",
        "Quotation",
        "Invoice",
        "Payment Proof",
        "Manuscript",
        "Book Cover File",
        "Typesetting File",
        "Final Print File",
        "Proof Approval",
        "ISBN Document",
        "Copyright Page",
        "Printing Spec",
        "Courier Document",
        "Client Supplied",
        "Internal Admin"
      ],
      "default": "Client Supplied"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent to Client",
        "Opened",
        "Viewed",
        "Downloaded",
        "Awaiting Signature",
        "Signed",
        "Awaiting Approval",
        "Approved",
        "Rejected",
        "Changes Requested",
        "Payment Proof Uploaded",
        "Expired",
        "Archived"
      ],
      "default": "Draft"
    },
    "file_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_size_kb": {
      "type": "number"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "parent_doc_id": {
      "type": "string",
      "description": "Previous version document ID"
    },
    "is_latest_version": {
      "type": "boolean",
      "default": true
    },
    "book_title": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string",
      "description": "Admin-only notes"
    },
    "uploaded_by": {
      "type": "string"
    },
    "secure_token": {
      "type": "string",
      "description": "Unique token for secure client access link"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When secure link expires"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "downloaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "download_count": {
      "type": "number",
      "default": 0
    },
    "open_count": {
      "type": "number",
      "default": 0
    },
    "client_message": {
      "type": "string",
      "description": "Message from client (changes request, question)"
    },
    "proof_url": {
      "type": "string",
      "description": "Uploaded payment proof or signed copy URL"
    },
    "signature_url": {
      "type": "string",
      "description": "Electronic signature image URL"
    },
    "reminder_sent_count": {
      "type": "number",
      "default": 0
    },
    "last_reminder_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contact_id",
    "category",
    "file_name",
    "file_url"
  ]
}