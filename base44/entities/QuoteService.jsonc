{
  "name": "QuoteService",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "default_description": {
      "type": "string",
      "description": "Default line item description"
    },
    "default_price": {
      "type": "number",
      "description": "Default unit price"
    },
    "default_unit": {
      "type": "string",
      "description": "Unit label e.g. per word, per page, flat fee"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether service is available in quote builder"
    },
    "category": {
      "type": "string",
      "enum": [
        "editing",
        "design",
        "typesetting",
        "printing",
        "package",
        "ebook",
        "other"
      ],
      "default": "other",
      "description": "Service category for grouping"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdowns"
    }
  },
  "required": [
    "name"
  ]
}