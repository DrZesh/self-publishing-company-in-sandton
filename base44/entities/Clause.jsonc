{
  "name": "Clause",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Clause name e.g. Confidentiality Clause"
    },
    "category": {
      "type": "string",
      "enum": [
        "Confidentiality",
        "Payment",
        "Intellectual Property",
        "Cancellation",
        "Approval",
        "Revision Limits",
        "Delivery",
        "Liability",
        "Dispute Resolution",
        "General",
        "NDA",
        "Supplier"
      ],
      "default": "General"
    },
    "content": {
      "type": "string",
      "description": "Full clause text (may contain merge fields like {{client_name}})"
    },
    "short_description": {
      "type": "string",
      "description": "Brief one-line summary of what this clause does"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "content"
  ]
}