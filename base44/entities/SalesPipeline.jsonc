{
  "name": "SalesPipeline",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "isWon": {
            "type": "boolean"
          },
          "isLost": {
            "type": "boolean"
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_from_template": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}