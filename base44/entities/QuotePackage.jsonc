{
  "name": "QuotePackage",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "Parent Quote ID"
    },
    "name": {
      "type": "string",
      "description": "Package name e.g. Bronze, Silver, Gold"
    },
    "description": {
      "type": "string",
      "description": "Package description"
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "is_recommended": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features included (5-7 bullet points)"
    }
  },
  "required": [
    "quote_id",
    "name",
    "total_price"
  ]
}