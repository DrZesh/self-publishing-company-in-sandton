{
  "name": "ClientServiceProject",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Book Printing",
        "Book Editing",
        "Book Cover Design",
        "Typesetting and Layout",
        "Manuscript Evaluation",
        "Ghostwriting",
        "Author Website",
        "Ebook Publishing"
      ]
    },
    "project_title": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "assigned_team_member": {
      "type": "string"
    },
    "current_stage_key": {
      "type": "string"
    },
    "current_stage_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_hold",
        "completed",
        "cancelled"
      ],
      "default": "active"
    },
    "payment_receipt_url": {
      "type": "string"
    },
    "payment_receipt_name": {
      "type": "string"
    },
    "invoice_url": {
      "type": "string"
    },
    "invoice_name": {
      "type": "string"
    },
    "stage_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage_key": {
            "type": "string"
          },
          "stage_label": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          },
          "email_sent": {
            "type": "boolean"
          }
        }
      }
    },
    "last_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_emails_sent": {
      "type": "number",
      "default": 0
    },
    "welcome_email_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_name",
    "client_email",
    "service_type",
    "project_title"
  ]
}