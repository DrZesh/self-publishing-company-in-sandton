{
  "name": "QuoteLineItem",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "Parent Quote ID"
    },
    "service_id": {
      "type": "string",
      "description": "Optional linked QuoteService ID"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "line_total": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_optional": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an optional add-on"
    },
    "is_selected": {
      "type": "boolean",
      "default": true,
      "description": "Whether this item is selected (for add-ons)"
    }
  },
  "required": [
    "quote_id",
    "description"
  ]
}