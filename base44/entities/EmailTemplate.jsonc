{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "subject": {
      "type": "string",
      "description": "Email subject (supports merge fields)"
    },
    "body_html": {
      "type": "string",
      "description": "HTML body (supports merge fields)"
    },
    "category": {
      "type": "string",
      "enum": [
        "follow_up",
        "quote",
        "onboarding",
        "invoice",
        "general",
        "marketing"
      ],
      "default": "general"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "subject",
    "body_html"
  ]
}