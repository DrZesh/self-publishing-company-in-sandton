{
  "name": "BookingService",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name e.g. Consultation"
    },
    "description": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "buffer_minutes": {
      "type": "number",
      "default": 15,
      "description": "Gap after each appointment"
    },
    "allowed_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "on_site",
          "zoom"
        ]
      },
      "description": "Which meeting modes are available for this service"
    },
    "prep_tips": {
      "type": "string",
      "description": "Tips shown to client after booking, e.g. bring your manuscript"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "duration_minutes"
  ]
}